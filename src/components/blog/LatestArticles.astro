---
import ArticleCard from './ArticleCard.astro';
import articles from '../../data/latest-articles.json';
---
<section class="px-8 max-sm:px-4 tablet:pb-32 pb-12">
          <div class="max-w-90rem mx-auto w-full">
            <!-- Letest Article Header -->
            <div
              class="tablet:pt-12 pt-8 mb-16 max-sm:mb-12 border-t border-brand-espresso-300"
            >
              <h2
                class="leading-[1.2] tracking-[-.03em] text-[clamp(1.125rem,0.9049rem+0.939vw,1.75rem)]"
              >
                Lastest Articles
              </h2>
            </div>
            <!-- Letest Article Card Wrapper -->
            <div
              class="grid tablet:grid-cols-3 grid-cols-2 max-sm:grid-cols-1 gap-y-[3rem] gap-x-12"
            >
              <!-- Letest Article Card -->
              <ArticleCard {...articles[0]} />
              <!-- Letest Article Card -->
              <ArticleCard {...articles[1]} />
              <!-- Letest Article Card -->
              <ArticleCard {...articles[2]} />
            </div>
            <div class="tablet:mt-[5.375rem] mt-12 flex justify-center">
              <a
                class="py-[1.25rem] px-[1.5rem] rounded-full flex items-center justify-center text-center bg-brand-espresso-500 text-brand-ivory font-medium leading-[1] text-[clamp(1rem,0.868rem+0.5634vw,1.375rem)] transition-colors duration-[300ms] ease hover:bg-brand-espresso-300"
                href="#"
                ><span>Load more</span></a
              >
            </div>
          </div>
        </section>
