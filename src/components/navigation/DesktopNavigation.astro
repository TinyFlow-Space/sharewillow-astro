---
import Dropdown from './Dropdown.astro';
const { home = false, blog = false } = Astro.props;
---
<nav
            aria-label="Main Navigation"
            class="hidden nav-desktop:flex items-center gap-6 lg:gap-8 text-brand-espresso font-medium text-[1rem] tracking-[-0.54px]"
          >
            <ul class={home ? 'flex items-center gap-6' : blog ? 'flex items-center gap-6 lg:gap-8' : 'flex items-center gap-6'}>
              <!-- Solutions Dropdown -->
              <Dropdown label="Solutions" home={home} first={true} itemClass="relative group py-2 nav-dropdown-item">
<ul class="space-y-1">
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                        >
                          <span class="font-medium">For Companies</span>
                          <svg
                            class="w-4 h-4 text-gray-400 group-hover/item:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                          </svg>
                        </a>
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                        >
                          <span class="font-medium text-brand-espresso"
                            >For Employees</span
                          >
                          <svg
                            class="w-4 h-4 text-gray-400 group-hover/item:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                          </svg>
                        </a>
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                        >
                          <span class="font-medium text-brand-espresso"
                            >Plan Design Consultation</span
                          >
                          <svg
                            class="w-4 h-4 text-gray-400 group-hover/item:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                          </svg>
                        </a>
                      </li>
                    </ul>
</Dropdown>

              <!-- Resources Dropdown -->
              <Dropdown label="Resources" home={home} first={false} itemClass="relative group py-2 nav-dropdown-item">
<ul class="space-y-1">
                      <li>
                        <a
                          href="./blog.html"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Blog & Insights</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Case Studies</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Incentive Calculator</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Documentation</a
                        >
                      </li>
                    </ul>
</Dropdown>

              <!-- Industries Dropdown -->
              <Dropdown label="Industries" home={home} first={false} itemClass={home ? 'relative group py-2 px-1 nav-dropdown-item' : 'relative group py-2 nav-dropdown-item'}>
<ul class="space-y-1">
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Technology & SaaS</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Manufacturing</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Healthcare</a
                        >
                      </li>
                      <li>
                        <a
                          href="#"
                          class="flex items-center justify-between p-3 rounded-xl text-brand-espresso-300 hover:bg-brand-ivory hover:text-brand-espresso-500 transition-colors group/item"
                          >Professional Services</a
                        >
                      </li>
                    </ul>
</Dropdown>

              <li class={home ? "" : undefined}>
                <a
                  href="#pricing"
                  class="py-2 px-1 hover:text-brand-espresso-300 transition-colors"
                  >Pricing</a
                >
              </li>
              <li class={home ? "" : undefined}>
                <a
                  href="#about"
                  class="py-2 px-1 hover:text-brand-espresso-300 transition-colors"
                  >About</a
                >
              </li>
              <li class={home ? "" : undefined}>
                <a
                  href="#features"
                  class="py-2 px-1 hover:text-brand-espresso-300 transition-colors"
                  >Features</a
                >
              </li>
            </ul>
          </nav>
