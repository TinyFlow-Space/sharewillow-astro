---
import "lenis/dist/lenis.css";
import "@/styles/global.css";
import Header from "@/components/navigation/Header.astro";
import Footer from "@/components/Footer.astro";
const { page } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <slot name="head" />
  </head>
  <body class="font-body">
    <div class="page-wrapper overflow-clip">
      <a
        data-target="skip-link"
        href="#main-content"
        class="fixed top-0 left-0 w-full text-center z-[9999] -translate-y-[200%] focus:translate-y-0 bg-brand-espresso-500 text-white font-semibold px-6 py-3 shadow-xl transition-transform duration-200"
      >
        Skip to Main
      </a>
      <Header page={page} />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
